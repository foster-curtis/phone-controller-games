    {
      "path": "art/neon-knights/**",
      "source": "Original work for Fort Frenzy",
      "author": "Foster Curtis",
      "license": "owned",
      "commercial": true
    },
    {
      "path": "audio/kenney/impact-sounds/**",
      "source": "https://kenney.nl/assets/impact-sounds",
      "author": "Kenney (www.kenney.nl)",
      "license": "CC0-1.0",
      "commercial": true
    },
    {
      "path": "audio/kenney/interface-sounds/**",
      "source": "https://kenney.nl/assets/interface-sounds",
      "author": "Kenney (www.kenney.nl)",
      "license": "CC0-1.0",
      "commercial": true
    },
    {
      "path": "audio/kenney/sci-fi-sounds/**",
      "source": "https://kenney.nl/assets/sci-fi-sounds",
      "author": "Kenney (www.kenney.nl)",
      "license": "CC0-1.0",
      "commercial": true
    },
    {
